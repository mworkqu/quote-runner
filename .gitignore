# --- secrets --------------------------------------------------------------
# Nothing matching these exists in the repo today; they are here so a stray
# key or dotenv can never be committed by accident later. Google ADC lives in
# ~/AppData/Roaming/gcloud/ (outside this tree) and is not covered by design.
.env
.env.*
!.env.template
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
service-account*.json
service_account*.json
*-key.json
*_key.json
application_default_credentials.json
gha-creds-*.json
.gcloud/
secrets/
*.secret

# --- editor / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
